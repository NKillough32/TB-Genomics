DATABASE_URL=postgresql://tb:tb@localhost/tb_surveillance
TB_AUTO_MIGRATE=1

# Use local for development. Set to production in deployed environments; unsafe
# auth/demo/CORS settings will block application startup.
TB_DEPLOYMENT_MODE=local

# Comma-separated browser origins allowed by FastAPI CORS.
TB_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Leave unset for local PoC development. Set to 1 in shared or deployed environments.
TB_AUTH_REQUIRED=0

# Format: token=role,role;another-token=viewer
# Roles are hierarchical: admin > operator > analyst > viewer.
TB_AUTH_TOKENS=change-me-admin-token=admin

# Legacy ingest key remains supported for local ingest scripts.
TB_INGEST_API_KEY=

TB_ENABLE_SYNTHETIC_SEEDING=0
TB_ALLOW_NON_OPERATIONAL_ACTIONS=0

# Outbreaker2 execution controls.
TB_ALLOW_MOCK_OUTBREAKER=0
TB_OUTBREAKER_TIMEOUT_SEC=1200
TB_OUTBREAKER_ITER=50000
TB_OUTBREAKER_BURNIN=10000
TB_OUTBREAKER_THIN=10
TB_OUTBREAKER_AUTO_EXTEND=1
TB_OUTBREAKER_RELIABLE_ITER=250000
TB_OUTBREAKER_RELIABLE_BURNIN=50000
TB_OUTBREAKER_RELIABLE_THIN=10

# Runtime directories. Leave unset for the current Windows/repository-local layout.
# Set these on Posit Connect if runtime state should live outside the deployed bundle.
TB_EXPORTS_DIR=
TB_UPLOADS_DIR=
TB_LOGS_DIR=

# Lineage/DR input selection and external-tool fallback controls.
LINEAGE_DR_FASTA=
TB_LINEAGE_DR_FASTA=
TBPROFILER_WSL_FALLBACK=0
