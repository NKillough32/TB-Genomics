nextflow.enable.dsl = 2

params {
  sample_sheet = "validation/tb_wgs/samples.csv"
  reference = "validation/tb_wgs/reference/ref.fasta"
  mask_bed = "validation/tb_wgs/reference/mask.bed"
  outdir = "results/tb_wgs"
  pipeline_version = "0.1.0"
  min_reads = 1
  min_bases = 20
  max_ambiguous_percent = 5.0
  min_mean_depth = 1.0
  cluster_threshold = 12
}

process {
  executor = "local"
  errorStrategy = "terminate"
  publishDir = [
    path: params.outdir,
    mode: "copy",
    overwrite: true
  ]
}

profiles {
  docker {
    docker.enabled = true
  }

  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
  }

  validation {
    process.container = "python:3.11-slim"
  }
}
